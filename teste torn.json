        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3.1:8b\",\n  \"prompt\": \"Voce eh um classificador juridico. Responda APENAS JSON valido neste formato: {\\\"is_valid\\\":true,\\\"case_type\\\":\\\"...\\\",\\\"reason\\\":\\\"...\\\",\\\"confidence\\\":0.0,\\\"urgency\\\":\\\"alta|media|baixa\\\"}. Classifique o relato:\\n\\n{{$json.relato}}\",\n  \"stream\": false\n}\n\n",
        "options": {}
      },
