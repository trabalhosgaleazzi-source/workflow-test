      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst raw = j.response || '';\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch {\n  parsed = {\n    is_valid: false,\n    case_type: 'indefinido',\n    reason: 'Falha ao interpretar JSON da IA',\n    confidence: 0,\n    urgency: 'media'\n  };\n}\n\nreturn [{\n  json: {\n    ...j,\n    ai: {\n      is_valid: !!parsed.is_valid,\n      case_type: parsed.case_type || 'indefinido',\n      reason: parsed.reason || 'Sem justificativa',\n      confidence: Number(parsed.confidence ?? 0),\n      urgency: parsed.urgency || 'media'\n    }\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "22708bf7-e7fa-4cd8-a8f1-ed4c4cd35f7d",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst content = JSON.stringify(item.json, null, 2);\n\nitem.binary = {\n  data: {\n    data: Buffer.from(content, 'utf8').toString('base64'),\n    mimeType: 'application/json',\n    fileName: `valid_${Date.now()}.json`,\n  },\n};\n\nreturn [item];\n"
      },
