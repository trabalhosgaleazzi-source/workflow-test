    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const b64 = item.binary.data.data;\n  let text = Buffer.from(b64, 'base64').toString('utf8');\n\n  // Remove BOM e espaços estranhos\n  text = text.replace(/^\\uFEFF/, '').trim();\n\n  try {\n    out.push({ json: JSON.parse(text) });\n  } catch (e) {\n    // Não quebra o fluxo: devolve info do arquivo com erro\n    out.push({\n      json: {\n        parse_error: true,\n        fileName: item.binary?.data?.fileName || 'unknown',\n        message: e.message,\n        raw_preview: text.slice(0, 500)\n      }\n    });\n  }\n}\n\nreturn out;\n\n"
      },
